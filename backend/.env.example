# Supabase (Sydney ap-southeast-2).
# Use the session-pooler URI from Supabase Dashboard → Connect →
# Session pooler tab. Prefix `postgresql://` with `+psycopg` so
# SQLAlchemy selects the psycopg3 driver. If your password contains
# URL-reserved characters (@ : / # ? & + % space [ ]) they MUST be
# percent-encoded — the easiest fix is to regenerate the password
# in Supabase Dashboard → Project Settings → Database (Supabase
# auto-generates URL-safe passwords).
SUPABASE_DB_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude (US-hosted direct API)
ANTHROPIC_API_KEY=sk-ant-

# Voyage AI embeddings (US-hosted)
VOYAGE_API_KEY=

# LangSmith observability.
# Modern LANGSMITH_* env-var naming (SDK switched from LANGCHAIN_*
# in late 2024). LANGSMITH_ENDPOINT is optional and accepts regional
# endpoints; https://apac.api.smith.langchain.com routes traces
# through the APAC region for AU-closer observability.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ato-assistant-dev
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
